@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{--bg:#080d18;--panel:#111a2b;--text:#f4f5f8;--muted:#9ba8ba;--blue:#8bc8ff;--line:rgba(190,210,240,.14);--mono:'DM Mono',monospace;--display:'Space Grotesk',sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}.topbar{height:78px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:absolute;z-index:2;top:0;width:100%}.brand{font:700 20px var(--display);letter-spacing:3px}.brand-icon{color:var(--blue);font-size:28px;vertical-align:-2px;margin-right:7px}.topbar nav{display:flex;gap:34px;color:#bac4d2;font-size:13px}.topbar nav a:hover{color:white}.top-cta{border:1px solid #53677f;padding:11px 16px;border-radius:3px;font-size:12px}.top-cta span{color:var(--blue);margin-left:10px}.hero{min-height:700px;height:94vh;max-height:900px;position:relative;overflow:hidden;padding:180px 10% 90px;display:flex;align-items:center;background:radial-gradient(ellipse at 75% 48%,#182d49 0%,#0d1728 35%,#080d18 72%)}.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(140,180,220,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(140,180,220,.035) 1px,transparent 1px);background-size:55px 55px;mask-image:linear-gradient(90deg,transparent,#000)}.hero-copy{position:relative;z-index:1;max-width:560px}.eyebrow,.section-kicker,.hero-bottom,.dest-count,.card-top,.date,.coordinates,.modal-kicker,.modal h3,.mission>span,footer>span{font:10px var(--mono);letter-spacing:1.7px}.eyebrow{color:var(--blue);display:flex;align-items:center;gap:10px}.pulse{width:7px;height:7px;border-radius:50%;background:#6de3b0;box-shadow:0 0 12px #6de3b0}.hero h1{font:600 clamp(54px,7vw,88px)/.99 var(--display);letter-spacing:-5px;margin:28px 0}.hero h1 em,.intro h2 em,.dest-head h2 em{color:var(--blue);font-style:normal}.hero-copy>p{max-width:420px;color:#aab6c7;font-size:16px;line-height:1.8}.primary-button{display:inline-flex;gap:34px;align-items:center;margin-top:24px;background:#b9ddff;color:#07101d;padding:16px 20px;font-weight:700;font-size:13px;border-radius:3px}.primary-button span{font-size:20px}.hero-note{margin-top:28px;color:#8e9caf;font-size:11px}.hero-note span{color:var(--blue);margin-right:8px}.time-art{position:absolute;width:48%;height:80%;right:1%;top:10%;display:grid;place-items:center}.portal{width:min(34vw,390px);aspect-ratio:1;border-radius:50%;border:1px solid rgba(155,205,255,.6);display:grid;place-items:center;box-shadow:0 0 70px #3a8dd833,inset 0 0 70px #3a8dd822;animation:float 6s ease-in-out infinite}.portal-inner{width:78%;height:78%;border-radius:50%;border:1px solid #9ed3ff66;background:radial-gradient(circle,#5c9bd344,#162d4d66 48%,#08101e 72%);display:grid;place-items:center;box-shadow:0 0 55px #56aaff33}.portal-inner span{font-size:100px;color:#b4dcff;text-shadow:0 0 35px #63b5ff}.orbit{position:absolute;border:1px solid #9acfff33;border-radius:50%;width:95%;height:38%;transform:rotate(-28deg)}.orbit-two{width:105%;height:48%;transform:rotate(42deg)}.floating{position:absolute;font:10px var(--mono);letter-spacing:1px;color:#c8e5ff;background:#13253a;border:1px solid #5c85a744;padding:9px 12px}.f1{top:22%;right:12%}.f2{bottom:23%;right:10%}.f3{top:45%;left:3%}.coordinates{position:absolute;bottom:7%;right:13%;color:#9ab1c9;line-height:1.8}.coordinates small{font-size:8px;color:#637a94}.hero-bottom{position:absolute;bottom:28px;left:10%;right:10%;display:flex;justify-content:space-between;color:#708096;font-size:9px}.intro{text-align:center;padding:120px 8% 110px;background:#0b1220}.section-kicker{color:var(--blue)}.intro h2,.dest-head h2{font:600 clamp(38px,5vw,58px)/1.08 var(--display);letter-spacing:-2px;margin:20px 0}.intro>p{color:var(--muted);max-width:530px;margin:0 auto;line-height:1.8}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:35px;max-width:950px;margin:65px auto 0;text-align:left}.steps div{border-top:1px solid #304158;padding-top:18px;display:flex;flex-direction:column;gap:12px}.steps b{font:12px var(--mono);color:var(--blue)}.steps strong{font:600 18px var(--display)}.steps span{font-size:13px;color:var(--muted);line-height:1.6}.destinations{padding:110px 8%;max-width:1500px;margin:auto}.dest-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:42px}.dest-head h2{margin-bottom:0}.dest-count{color:#7f8da1;padding-bottom:12px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.destination-card{background:#111c2d;border:1px solid #26374d;min-width:0;overflow:hidden;transition:.25s}.destination-card:hover{transform:translateY(-5px);border-color:#7199c0}.card-top{display:flex;justify-content:space-between;padding:18px 20px;color:#899bb0}.card-top span:last-child{font-size:20px}.card-visual{height:170px;position:relative;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle,#34506c,#14263b 55%,#101b2c)}.visual-symbol{font-size:76px;position:relative;z-index:1;filter:drop-shadow(0 8px 18px #0008)}.visual-ring{position:absolute;width:145px;height:145px;border:1px solid #a9d5ff55;border-radius:50%;box-shadow:0 0 35px #8bc8ff22}.egipto .card-visual{background:radial-gradient(circle,#79603b,#342a28 65%,#151b26)}.roma .card-visual{background:radial-gradient(circle,#72564b,#342c31 65%,#151b26)}.medieval .card-visual{background:radial-gradient(circle,#425b60,#1c303b 65%,#151b26)}.mayo .card-visual{background:radial-gradient(circle,#42677a,#1c3445 65%,#151b26)}.futuro .card-visual{background:radial-gradient(circle,#554b83,#282443 65%,#151b26)}.card-info{padding:21px}.date{color:var(--blue);font-size:9px}.card-info h3{font:600 23px var(--display);margin:10px 0 5px}.card-info p{font-size:12px;color:var(--muted);margin:0 0 23px}.explore-button{width:100%;display:flex;justify-content:space-between;align-items:center;background:transparent;border:1px solid #42546b;color:#e8f3ff;padding:12px 14px;font:12px var(--display);cursor:pointer}.explore-button:hover{background:#1c3450}.explore-button span{color:var(--blue);font-size:17px}.quote{text-align:center;padding:90px 20px;background:#101b2c;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.quote>span{font:90px Georgia;color:#79bfff;line-height:.7}.quote p{font:500 clamp(22px,3vw,34px)/1.4 var(--display)}.quote small{font:9px var(--mono);letter-spacing:2px;color:#8194ab}footer{min-height:100px;padding:25px 8%;display:flex;align-items:center;justify-content:space-between;gap:20px}footer>span{color:#77869a;font-size:8px}.modal-backdrop{position:fixed;inset:0;background:#02060dcc;z-index:10;display:none;align-items:center;justify-content:center;padding:20px;overflow:auto}.modal-backdrop.open{display:flex}.modal{position:relative;background:#101c2d;border:1px solid #45617e;max-width:620px;width:100%;max-height:90vh;overflow:auto;padding:38px}.close-modal{position:absolute;right:18px;top:14px;background:transparent;color:white;font-size:28px;border:0;cursor:pointer}.modal-kicker{color:var(--blue)}.modal-emoji{font-size:48px;margin:18px 0 5px}.modal h2{font:600 36px var(--display);margin:0 0 10px}.modal>p{color:#afbdce;line-height:1.7;font-size:14px}.modal h3{color:#7eaedc;margin-top:28px}.modal ul{padding-left:20px;color:#c4d0df;line-height:1.8;font-size:13px}.mission{margin-top:28px;padding:20px;background:#172940;border:1px solid #314b67}.mission>span{font-size:9px;color:var(--blue)}.mission>p{font-weight:600;line-height:1.5}.mission form{display:flex;gap:8px}.mission input{flex:1;min-width:0;background:#091321;border:1px solid #405773;color:white;padding:12px}.mission button{background:#b9ddff;color:#081321;border:0;padding:0 14px;font-weight:700;cursor:pointer}.mission #mission-result{font-size:12px;margin-top:12px;color:#8de0b5;min-height:16px}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-13px)}}
@media(max-width:850px){.hero{padding-left:7%;min-height:760px}.time-art{opacity:.4;width:65%;right:-12%;top:18%}.hero-copy{max-width:500px}.cards{grid-template-columns:repeat(2,1fr)}.destinations{padding:80px 6%}.topbar{padding:0 5%}}
@media(max-width:560px){.topbar{height:68px}.topbar nav{display:none}.top-cta{font-size:10px;padding:9px}.hero{height:auto;min-height:730px;padding:150px 7% 100px;align-items:flex-start}.hero h1{font-size:58px;letter-spacing:-3px}.hero-copy>p{font-size:14px}.time-art{width:100%;height:48%;top:48%;right:-15%;opacity:.32}.portal{width:260px}.portal-inner span{font-size:70px}.hero-bottom{left:7%;right:7%;font-size:7px}.intro{padding:85px 7%}.steps{grid-template-columns:1fr;gap:25px;margin-top:45px}.destinations{padding:80px 6%}.dest-head{display:block}.dest-count{display:block;margin-top:18px}.cards{grid-template-columns:1fr}.card-visual{height:150px}.quote{padding:70px 20px}footer{flex-direction:column;align-items:flex-start;padding:28px 7%}.modal{padding:28px 20px}.mission form{flex-direction:column}.mission button{padding:12px}}
